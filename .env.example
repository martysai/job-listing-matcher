# LLM provider credentials
MISTRAL_API_KEY=
RERANK_LLM_PROVIDER=litellm
RERANK_LLM_MODEL=mistral/mistral-small-latest
RERANK_LLM_API_BASE=

# Rerank expert scoring throttling and retry
RERANK_REQUEST_DELAY_SECONDS=2.0
RERANK_RATE_LIMIT_MAX_RETRIES=6
RERANK_RATE_LIMIT_BACKOFF_BASE_SECONDS=2.0
RERANK_RATE_LIMIT_BACKOFF_MAX_SECONDS=60.0
RERANK_MAX_CONCURRENCY=1
RERANK_MICRO_BATCH_SIZE=1
RERANK_MICRO_BATCH_AUTOTUNE=true
RERANK_MICRO_BATCH_TUNE_ROWS=24
RERANK_SCORING_VALIDATION_FRACTION=0.2
RERANK_TRAIN_MAX_NEGATIVES_PER_CANDIDATE=4
RERANK_VALIDATION_MAX_NEGATIVES_PER_CANDIDATE=4
RERANK_BENCHMARK_USER_FRACTION=0.05

# LLM provider credentials
GEMINI_API_KEY=

# ── Adzuna API ────────────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# ── Adzuna limits (free tier: 250 req/day, 25 req/min) ───────────────────────
DAILY_REQUEST_BUDGET=230
RESULTS_PER_REQUEST=50
ADZUNA_VACANCY_TTL_DAYS=14

# ── LLM for agent ───────────────────────────────────────────
#VACANCY_AGENT_LLM_MODEL=mistral/mistral-large-latest
VACANCY_AGENT_LLM_MODEL=mistral/mistral-small-latest
#VACANCY_AGENT_LLM_MODEL=gemini/gemini-2.5-flash

# ── LLM for SGR-extraction ────────────────────────────────────
VACANCY_EXTRACTOR_LLM_MODEL=mistral/mistral-small-latest
VACANCY_EXTRACTOR_LLM_LOG_PATH=data/logs/vacancy_extractor.jsonl
VACANCY_EXTRACTOR_DELAY=3
ADZUNA_MAX_VACANCIES=3

# ── Infrastructure ────────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DB_PATH=data/chroma
ADZUNA_VACANCIES_JSONL=data/raw/adzuna_vacancies.jsonl
ADZUNA_COUNTER_PATH=data/processed/profile_counter.json

SCRAPE_DELAY_SECONDS=2.5
CHROMA_COLLECTION_NAME=vacancies
