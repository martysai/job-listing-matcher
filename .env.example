# Dev env
HTTPS=false # true by default

# LLM provider credentials
MISTRAL_API_KEY=
# Path to a file containing your GitHub PAT (with models:read permission)
# used for GitHub Models (https://models.github.ai/inference). The token is
# read from this file at call time; it never enters environment variables,
# process listings, or shell history.
GITHUB_MODELS_KEY_PATH=key.txt
# Comma-separated provider attempt order. First name is primary.
LLM_PROVIDER_ORDER=mistral,github
# Seconds to skip a provider after it returned a transient error.
LLM_PROVIDER_COOLDOWN_S=60

RERANK_LLM_PROVIDER=litellm
RERANK_LLM_MODEL=mistral/mistral-small-latest
RERANK_LLM_API_BASE=

# Recommender pipeline
VACANCIES_PATH=data/raw/vacancies_safe_ml_dataset_nozip.jsonl
CHROMA_DIR=data/chroma
LAMBDARANK_MODEL_PATH=

# Rerank expert scoring throttling and retry
RERANK_REQUEST_DELAY_SECONDS=2.0
RERANK_RATE_LIMIT_MAX_RETRIES=6
RERANK_RATE_LIMIT_BACKOFF_BASE_SECONDS=2.0
RERANK_RATE_LIMIT_BACKOFF_MAX_SECONDS=60.0
RERANK_MAX_CONCURRENCY=1
RERANK_MICRO_BATCH_SIZE=1
RERANK_MICRO_BATCH_AUTOTUNE=true
RERANK_MICRO_BATCH_TUNE_ROWS=24
RERANK_SCORING_VALIDATION_FRACTION=0.2
RERANK_TRAIN_MAX_NEGATIVES_PER_CANDIDATE=4
RERANK_VALIDATION_MAX_NEGATIVES_PER_CANDIDATE=4
RERANK_BENCHMARK_USER_FRACTION=0.05

# ── Adzuna vacancy refresh loop ───────────────────────────────────────────────
# Periodic background job that runs the LangGraph ReAct Adzuna agent and
# hot-merges fresh vacancies into the live Chroma + BM25 index. Auto-disables
# if ADZUNA_APP_ID / ADZUNA_APP_KEY / any LLM key is missing — the API keeps
# serving from the existing index in that case.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
VACANCY_REFRESH_ENABLED=true
# Comma-separated "country:city" pairs. Adzuna supports: gb, us, at, au, be,
# br, ca, ch, de, es, fr, in, it, mx, nl, nz, pl, sg, za (not rs / ru).
VACANCY_REFRESH_LOCATIONS=gb:london,de:berlin,nl:amsterdam
VACANCY_REFRESH_ROLES=data scientist,machine learning engineer,software engineer
VACANCY_REFRESH_INTERVAL_SECONDS=21600
VACANCY_REFRESH_INITIAL_DELAY_SECONDS=30
VACANCY_AGENT_LLM_MODEL=mistral/mistral-large-latest
VACANCY_AGENT_LLM_RPS=0.3
VACANCY_EXTRACTOR_LLM_MODEL=mistral/mistral-small-latest
